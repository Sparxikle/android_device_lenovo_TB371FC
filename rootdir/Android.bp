// fstab
prebuilt_etc {
    name: "fstab.qcom",
    src: "etc/fstab.qcom",
    vendor: true,
    ramdisk_available: true,
}

// Init configuration files
prebuilt_etc {
    name: "init.qcom.rc",
    src: "etc/init.qcom.rc",
    sub_dir: "init/hw",
    vendor: true,
}

prebuilt_etc {
    name: "init.qcom.power.rc",
    src: "etc/init.qcom.power.rc",
    sub_dir: "init/hw",
    vendor: true,
}

prebuilt_etc {
    name: "init.target.rc",
    src: "etc/init.target.rc",
    sub_dir: "init/hw",
    vendor: true,
}

prebuilt_etc {
    name: "init.recovery.qcom.rc",
    src: "etc/init.recovery.qcom.rc",
    sub_dir: "init",
    recovery: true,
}

prebuilt_etc {
    name: "init.tb371fc.rc",
    src: "etc/init.tb371fc.rc",
    sub_dir: "init",
    system_ext_specific: true,
}

// Bring-up boot logger (remove once the device boots)
sh_binary {
    name: "tb371fc-bootlog.sh",
    src: "bin/tb371fc-bootlog.sh",
    vendor: true,
}

prebuilt_etc {
    name: "init.tb371fc.bootlog.rc",
    src: "etc/init.tb371fc.bootlog.rc",
    sub_dir: "init",
    vendor: true,
}
