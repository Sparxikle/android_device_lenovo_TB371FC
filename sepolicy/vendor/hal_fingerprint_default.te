# Goodix fingerprint HAL: /dev/goodix_fp for power, reset and IRQ, netlink
# for IRQ and screen events, QSEECom for the goodixfp trusted app.
allow hal_fingerprint_default vendor_goodix_fp_device:chr_file rw_file_perms;
allow hal_fingerprint_default tee_device:chr_file rw_file_perms;
allow hal_fingerprint_default self:netlink_socket create_socket_perms_no_ioctl;
allow hal_fingerprint_default uhid_device:chr_file rw_file_perms;
allow hal_fingerprint_default ion_device:chr_file r_file_perms;

allow hal_fingerprint_default fingerprint_vendor_data_file:dir create_dir_perms;
allow hal_fingerprint_default fingerprint_vendor_data_file:file create_file_perms;

set_prop(hal_fingerprint_default, vendor_fp_prop)
get_prop(hal_fingerprint_default, vendor_goodix_default_prop)
